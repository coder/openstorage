// SDK compatibility harness: driven by internal/api/sdkcompat_test.go, which
// copies this file into a temporary module whose go.mod `replace`s the vendor
// Go SDK (github.com/pierrecomputer/sdk/packages/code-storage-go, unmodified
// copy) and runs it against the in-process codestorage API server.
//
// Exit code 0 + final "SDKCOMPAT OK" line means the vendor SDK performed
// CreateRepo -> FindOne -> ListRepos -> DeleteRepo -> FindOne(nil) ->
// DeleteRepo(already deleted) against our /api/v1 surface.
package main

import (
	"context"
	"flag"
	"fmt"
	"os"
	"strings"
	"time"

	storage "github.com/pierrecomputer/sdk/packages/code-storage-go"
)

func fatalf(format string, args ...any) {
	fmt.Fprintf(os.Stderr, "SDKCOMPAT FAIL: "+format+"\n", args...)
	os.Exit(1)
}

func main() {
	apiBase := flag.String("api", "", "API base URL of the codestorage server")
	org := flag.String("org", "", "organization name (JWT iss)")
	keyPath := flag.String("key", "", "path to the ES256 private key PEM")
	flag.Parse()
	if *apiBase == "" || *org == "" || *keyPath == "" {
		fatalf("usage: -api <url> -org <name> -key <pem-path>")
	}

	keyPEM, err := os.ReadFile(*keyPath)
	if err != nil {
		fatalf("read key: %v", err)
	}

	client, err := storage.NewClient(storage.Options{
		Name:       *org,
		Key:        string(keyPEM),
		APIBaseURL: *apiBase,
	})
	if err != nil {
		fatalf("NewClient: %v", err)
	}

	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()

	// CreateRepo (SDK generates the repo id / url claim as a UUID).
	repo, err := client.CreateRepo(ctx, storage.CreateRepoOptions{})
	if err != nil {
		fatalf("CreateRepo: %v", err)
	}
	if repo.ID == "" {
		fatalf("CreateRepo returned empty repo ID")
	}
	fmt.Printf("created repo %s (default branch %s)\n", repo.ID, repo.DefaultBranch)

	// Duplicate create must surface the 409 as "repository already exists".
	if _, err := client.CreateRepo(ctx, storage.CreateRepoOptions{ID: repo.ID}); err == nil {
		fatalf("duplicate CreateRepo succeeded, want already-exists error")
	} else if !strings.Contains(err.Error(), "already exists") {
		fatalf("duplicate CreateRepo error = %q, want already-exists", err)
	}
	fmt.Println("duplicate create rejected with already-exists")

	// FindOne must locate the repo and unmarshal our GET /repo response.
	found, err := client.FindOne(ctx, storage.FindOneOptions{ID: repo.ID})
	if err != nil {
		fatalf("FindOne: %v", err)
	}
	if found == nil {
		fatalf("FindOne returned nil for existing repo %s", repo.ID)
	}
	if found.DefaultBranch != "main" {
		fatalf("FindOne default branch = %q, want main", found.DefaultBranch)
	}
	if _, err := time.Parse(time.RFC3339, found.CreatedAt); err != nil {
		fatalf("FindOne created_at %q is not RFC 3339: %v", found.CreatedAt, err)
	}
	fmt.Printf("found repo %s created_at %s\n", found.ID, found.CreatedAt)

	// ListRepos must include it.
	list, err := client.ListRepos(ctx, storage.ListReposOptions{})
	if err != nil {
		fatalf("ListRepos: %v", err)
	}
	present := false
	for _, entry := range list.Repos {
		if entry.URL == repo.ID {
			present = true
			if entry.RepoID == "" {
				fatalf("listed repo %s has empty repo_id", entry.URL)
			}
		}
	}
	if !present {
		fatalf("ListRepos (%d repos) does not contain %s", len(list.Repos), repo.ID)
	}
	fmt.Printf("list contains repo (total %d)\n", len(list.Repos))

	// DeleteRepo -> {repo_id, message}.
	deleted, err := client.DeleteRepo(ctx, storage.DeleteRepoOptions{ID: repo.ID})
	if err != nil {
		fatalf("DeleteRepo: %v", err)
	}
	if deleted.RepoID == "" || deleted.Message == "" {
		fatalf("DeleteRepo result = %+v, want repo_id and message", deleted)
	}
	fmt.Printf("deleted repo (%s)\n", deleted.Message)

	// FindOne on the soft-deleted repo: SDK maps the 404 to (nil, nil).
	found, err = client.FindOne(ctx, storage.FindOneOptions{ID: repo.ID})
	if err != nil {
		fatalf("FindOne after delete: %v", err)
	}
	if found != nil {
		fatalf("FindOne after delete = %+v, want nil", found)
	}
	fmt.Println("find after delete returned nil")

	// Second delete: SDK maps the 409 to "repository already deleted".
	if _, err := client.DeleteRepo(ctx, storage.DeleteRepoOptions{ID: repo.ID}); err == nil {
		fatalf("second DeleteRepo succeeded, want already-deleted error")
	} else if !strings.Contains(err.Error(), "already deleted") {
		fatalf("second DeleteRepo error = %q, want already-deleted", err)
	}
	fmt.Println("re-delete rejected with already-deleted")

	fmt.Println("SDKCOMPAT OK")
}
